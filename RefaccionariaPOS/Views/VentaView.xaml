<Window x:Class="RefaccionariaPOS.Views.VentaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Punto de Venta - Mostrador" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F1F2F6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" Margin="15" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="🛒 Carrito de Compras Actual" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="Los productos agregados se muestran aquí." FontSize="12" Foreground="#7F8C8D"/>
                </StackPanel>

                <DataGrid x:Name="dgCarrito" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                          Background="White" RowHeight="35" RowHeaderWidth="0" AlternatingRowBackground="#F8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="130" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Refacción / Producto" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Precio U." Binding="{Binding PrecioVenta, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="100" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>

                <DockPanel Grid.Row="2" Margin="0,15,0,0">
                    <Button x:Name="btnCobrar" Content="💵 Registrar Venta" DockPanel.Dock="Right" Width="180" Height="45" 
                            Background="#2ECC71" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnCobrar_Click"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Orientation="Horizontal">
                        <TextBlock Text="TOTAL: " FontSize="22" FontWeight="Bold" Foreground="#34495E"/>
                        <TextBlock x:Name="lblTotalCarrito" Text="$0.00" FontSize="26" FontWeight="Black" Foreground="#E74C3C"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#ECF0F1" Margin="0,15,15,15" CornerRadius="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="🔍 Búsqueda de Refacciones" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <TextBlock Text="Escribe Código o Nombre:" FontSize="12" Foreground="#7F8C8D"/>

                    <TextBox x:Name="txtBuscarId" Height="35" FontSize="14" Padding="5,7,5,5" TextChanged="TxtBuscarId_TextChanged" KeyDown="TxtBuscarId_KeyDown"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dgResultadosBusqueda" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionMode="Single" SelectionChanged="DgResultadosBusqueda_SelectionChanged"
                          Background="White" RowHeight="35" HeadersVisibility="Column" Visibility="Collapsed" Cursor="Hand">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding CodigoBarras}" Width="80"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding PrecioVenta, StringFormat=C}" Width="70" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" x:Name="brdPreview" Background="White" CornerRadius="5" Padding="15" Visibility="Collapsed" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🔎 Vista Previa del Artículo" FontSize="14" FontWeight="Bold" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <TextBlock Text="Código de Barras:" FontSize="11" Foreground="#95A5A6"/>
                        <TextBlock x:Name="lblPreviewCodigo" Text="---" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Text="Nombre / Descripción:" FontSize="11" Foreground="#95A5A6"/>
                        <TextBlock x:Name="lblPreviewNombre" Text="---" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <TextBlock Text="Precio de Venta:" FontSize="11" Foreground="#95A5A6"/>
                        <TextBlock x:Name="lblPreviewPrecio" Text="$0.00" FontSize="20" FontWeight="Black" Foreground="#2980B9" Margin="0,0,0,15"/>

                        <TextBlock Text="Existencias Actuales (Stock):" FontSize="11" Foreground="#95A5A6"/>
                        <TextBlock x:Name="lblPreviewStock" Text="---" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,15"/>

                        <Separator Background="#BDC3C7" Margin="0,5,0,15"/>

                        <TextBlock Text="Cantidad a Agregar:" FontSize="11" Foreground="#95A5A6"/>
                        <TextBox x:Name="txtCantidadAgregar" Text="1" Height="35" FontSize="16" FontWeight="Bold" TextAlignment="Center" Padding="5,7,5,5"/>
                    </StackPanel>
                </Border>

                <Button Grid.Row="2" x:Name="btnAgregarAlCarrito" Content="🛒 AGREGAR AL CARRITO" Height="45" Margin="0,15,0,0" 
                        Background="#E67E22" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnAgregarAlCarrito_Click" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>