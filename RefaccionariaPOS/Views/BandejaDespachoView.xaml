<Window x:Class="RefaccionariaPOS.Views.BandejaDespachoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bandeja de Despacho - Solicitudes del Taller" Height="500" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F1F2F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🛎️ Bandeja de Despacho Express" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
            <Button x:Name="btnActualizar" Content="🔄 Actualizar" Margin="20,0,0,0" Width="100" Height="30" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnActualizar_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgSolicitudes" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="White" RowHeight="40" AlternatingRowBackground="#F9F9F9" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No. Orden" Binding="{Binding IdOrden}" Width="80"/>
                <DataGridTextColumn Header="Código de Barras" Binding="{Binding CodigoBarras}" Width="150"/>
                <DataGridTextColumn Header="Descripción de Pieza" Binding="{Binding NombreProducto}" Width="*"/>
                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60"/>

                <DataGridTemplateColumn Header="Acción" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Surtir Pieza" Background="#2ECC71" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="5" Click="BtnSurtir_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="Las piezas surtidas se descontarán automáticamente del inventario físico." FontSize="12" Foreground="#7F8C8D" Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </Grid>
</Window>