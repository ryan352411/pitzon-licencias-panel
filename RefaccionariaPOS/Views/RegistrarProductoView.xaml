<Window x:Class="RefaccionariaPOS.Views.RegistrarProductoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Nueva Refacción" Height="450" Width="400"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="NUEVO PRODUCTO" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Código de Barras:" Margin="0,5,0,2" FontWeight="SemiBold"/>
            <TextBox x:Name="txtCodigo" Height="25" Padding="3"/>

            <TextBlock Text="Nombre del Producto:" Margin="0,10,0,2" FontWeight="SemiBold"/>
            <TextBox x:Name="txtNombre" Height="25" Padding="3"/>

            <TextBlock Text="Descripción:" Margin="0,10,0,2" FontWeight="SemiBold"/>
            <TextBox x:Name="txtDescripcion" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="3"/>

            <TextBlock Text="Costo Proveedor ($):" Margin="0,10,0,2" FontWeight="SemiBold"/>
            <TextBox x:Name="txtCosto" Height="25" Padding="3"/>

            <TextBlock Text="Precio Venta ($):" Margin="0,10,0,2" FontWeight="SemiBold"/>
            <TextBox x:Name="txtPrecioVenta" Height="25" Padding="3"/>

            <TextBlock Text="Stock Inicial:" Margin="0,10,0,2" FontWeight="SemiBold"/>
            <TextBox x:Name="txtStock" Height="25" Padding="3"/>

            <UniformGrid Columns="2" Margin="0,20,0,0">
                <Button Content="Guardar" Background="#27AE60" Foreground="White" FontWeight="Bold" Height="35" Margin="5" Click="BtnGuardar_Click" Cursor="Hand"/>
                <Button Content="Cancelar" Background="#95A5A6" Foreground="White" FontWeight="Bold" Height="35" Margin="5" Click="BtnCancelar_Click" Cursor="Hand"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>