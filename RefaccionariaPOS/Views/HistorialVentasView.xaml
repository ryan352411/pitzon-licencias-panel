<Window x:Class="RefaccionariaPOS.Views.HistorialVentasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Ventas Realizadas"
        Height="450"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Registro de Ventas"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="dgHistorial"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="White"
                  RowHeight="35"
                  AlternatingRowBackground="#ecf0f1"
                  PreviewMouseRightButtonDown="DgHistorial_PreviewMouseRightButtonDown">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ver Detalles de la Venta"
                              Click="MenuVerDetalles_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Interno"
                                    Binding="{Binding Id}"
                                    Width="80"/>

                <DataGridTextColumn Header="Folio Venta"
                                    Binding="{Binding Folio}"
                                    Width="100"/>

                <DataGridTextColumn Header="Fecha y Hora"
                                    Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Width="180"/>

                <DataGridTextColumn Header="Total Cobrado"
                                    Binding="{Binding Total, StringFormat={}{0:C}}"
                                    Width="150"/>

                <DataGridTextColumn Header="Estado"
                                    Binding="{Binding Estado}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>